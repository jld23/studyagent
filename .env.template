# Google Cloud PCA Study Agent Environment Configuration
# Copy this file to .env and configure either Option A (Google AI) or Option B (Vertex AI).

# -----------------------------------------------------------------------------
# OPTION A: Google AI Mode (Google AI Studio / Gemini API Key)
# Ideal for standard developers, local testing, and individual study.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# OPTION B: Vertex AI Mode (Application Default Credentials / GCP / Argolis)
# Used automatically if GEMINI_API_KEY is not provided.
# Targets your GCP project using ADC (`gcloud auth application-default login`).
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Model Selection
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Secret Manager Settings (Optional: set to true in production GCP environments)
USE_GCP_SECRET_MANAGER=false
SECRET_MANAGER_KEY_NAME=pca-study-agent-gemini-key

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ENABLE_OTEL_TRACING=true

# Storage Settings
DATA_DIR=data
USER_PROFILES_DIR=data/user_profiles
STUDY_MATERIALS_DIR=data/study_materials
