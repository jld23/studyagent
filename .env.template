# Google Cloud PCA Study Agent Environment Configuration
# Copy this file to .env and fill in the required values.

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Google Cloud Project Settings
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Secret Manager Settings (Set to true in production GCP environments)
USE_GCP_SECRET_MANAGER=false
SECRET_MANAGER_KEY_NAME=pca-study-agent-gemini-key

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ENABLE_OTEL_TRACING=true

# Storage Settings
DATA_DIR=data
USER_PROFILES_DIR=data/user_profiles
STUDY_MATERIALS_DIR=data/study_materials
